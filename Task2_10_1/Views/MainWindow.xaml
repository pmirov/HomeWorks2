<Window x:Class="Task2_10_1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Task2_10_1"
        xmlns:vm="clr-namespace:Task2_10_1.ViewModels"
        mc:Ignorable="d"
        Title="Система входа" Height="250" Width="300" >
    <Window.Resources>
        <local:ColorConverter x:Key="ColorConverter"/>
    </Window.Resources>
    <Window.DataContext>
        <vm:MainWindowViewModel/>
    </Window.DataContext>
    <StackPanel Margin="20">
        <TextBlock Text="Форма входа" FontSize="16" FontWeight="Bold"/>
        <Grid Margin="0,10,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="6"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Label Content="Логин:" Grid.Column="0" Grid.Row="0"/>
            <TextBox Grid.Column="1" Grid.Row="0" Text="{Binding UserName}"/>
            <Label Content="Пароль:" Grid.Column="0" Grid.Row="2"/>
            <TextBox Grid.Column="1" Grid.Row="2" Text="{Binding Password}"/>
        </Grid>
        <Button Content="Войти" Width="60" Command="{Binding LoginCommand}" />
        <Border Background="{Binding IsSuccess, Converter={StaticResource ColorConverter}}" CornerRadius="3" Padding="3" Margin="0,10,0,0" Height="30">
            <TextBlock Text="{Binding StatusMessage}" TextAlignment="Center" Foreground="White" FontWeight="DemiBold" VerticalAlignment="Center"/>
        </Border>
    </StackPanel>
</Window>
