<Window x:Class="Task2_9_1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Task2_9_1"
        mc:Ignorable="d"
        Title="Color Viewer" Height="287" Width="380">
    <Window.CommandBindings>
        <CommandBinding Command="local:CustomCommands.ChangeColor" Executed="ChangedColor"/>
        <CommandBinding Command="Undo" Executed="UndoExecuted" CanExecute="UndoCanExecuted"/>
    </Window.CommandBindings>
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Действия">
                <MenuItem Command="local:CustomCommands.ChangeColor"/>
                <MenuItem Header="Отменить" Command="Undo"/>
            </MenuItem>
        </Menu>
        <Grid x:Name="GridBgrd" >
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Button Content="Изменить цвет" Grid.Row="1" Width="120" Height="25" 
                    Command="local:CustomCommands.ChangeColor"/>
            <Button Content="Отменить" Command="Undo" Grid.Row="2" Width="120" Height="25"/>
        </Grid>

    </DockPanel>
</Window>
