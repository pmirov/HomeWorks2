<Window x:Class="Task2_6_1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Task2_6_1"
        mc:Ignorable="d"
        Title="MainWindow" Height="250" Width="400">
    <Window.Resources>
        <local:TextToNumberConverter x:Key="TextToNumberConverter"/>
        <local:YesNoConverter x:Key="YesNoConverter"/>
    </Window.Resources>
    <StackPanel Margin="10">
        <TextBox x:Name="textBox" Margin="0,0,0,15" MaxLength="100"/>
        <CheckBox Content="Показать детали" x:Name="chkBox"/>
        <StackPanel Visibility="{Binding Path=IsChecked, ElementName=chkBox, Converter={StaticResource YesNoConverter}}" Margin="0,15,0,0">
            <TextBlock Text="{Binding Path=Text, ElementName=textBox, Converter={StaticResource TextToNumberConverter}, StringFormat=Длина текста: {0}}" Margin="0,0,0,5" />
            <ProgressBar Height="20" Value="{Binding Text, ElementName=textBox, Converter={StaticResource TextToNumberConverter}}"/>
        </StackPanel>
    </StackPanel>
</Window>
